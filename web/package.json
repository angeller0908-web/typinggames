{
  "name": "typingrally-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:og": "node scripts/build-og.mjs",
    "build:ads": "node scripts/update-ads-txt.mjs",
    "build": "npm run build:ads && npm run build:og && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "match:iframes": "node scripts/match-iframe-feed.mjs",
    "fetch:gamemonetize": "node scripts/fetch-gamemonetize-feed.mjs",
    "fetch:gamemonetize:all": "node scripts/fetch-gamemonetize-feed.mjs --strategy latest --all --pages 10 --delay-ms 3000 --out data/provider-feeds/gamemonetize-all.json",
    "fetch:gamepix": "node scripts/fetch-gamepix-feed.mjs",
    "review:gamepix": "node scripts/review-gamepix-candidates.mjs",
    "scan:iframes": "node scripts/fetch-gamemonetize-feed.mjs --strategy discover --num 100 --threshold 55"
  },
  "dependencies": {
    "@next/mdx": "^15.0.3",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@types/mdx": "^2.0.13",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/og": "^0.6.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
